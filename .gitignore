# ---------------------------------------------------------------------------
# NotBlocky repo 的忽略清單
#
# 原則：這個 repo 只收「別人真的需要的東西」——
#       starter kit 本身、網站真的會載入的檔案、授權與說明。
#       內部的規劃、翻譯草稿、渲染中間檔一律留在本機。
# ---------------------------------------------------------------------------

# Python 快取
__pycache__/
*.pyc

# 改名前的舊 zip 備份
*.bak

# 內部規劃書（活文件，含個人決策脈絡，不對外）
/PLAN.md

# 網站的翻譯工作檔（產生 en/ 用的中間物，不是網站的一部分）
/site/_zh_strings.txt
/site/_i18n_en.json

# 素材的中間檔：網頁載入的是 .webp 與 .jpg，
# 原始的 .gif（各 2.2MB）與未壓縮 .png 不進版控
/site/media/*.gif
/site/media/*.png

# 個人筆記與密鑰（永不入版控）
project-note.html
.env

# 資料庫檔（這個專案目前沒有，先擋著）
*.db
*.sqlite
*.sqlite3
/data/
